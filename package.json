{
  "name": "community-health-bridge",
  "version": "1.0.0",
  "description": "Multilingual community health literacy web service",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local server.js",
    "dev": "node --env-file-if-exists=.env.local --watch server.js",
    "build:css": "node scripts/build.js css",
    "build:js": "node scripts/build.js js",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.js",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/database.js migrate",
    "db:backup": "node --env-file-if-exists=.env.local scripts/database.js backup",
    "db:restore": "node --env-file-if-exists=.env.local scripts/database.js restore"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.8",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "clean-css": "^5.3.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "terser": "^5.51.2"
  }
}
